# Copy to .env.local and add your Supabase project values.
# Never put the service_role key in Vite or any browser-exposed variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Public bot username (without @); needed to build patient connect deep links.
VITE_TELEGRAM_BOT_USERNAME=your_clinic_bot
